# Client-safe build configuration
VITE_API_URL=
VITE_WS_URL=
VITE_APP_ENV=development

# Server runtime
APP_ENV=development
NODE_ENV=development
ALLOW_GUEST_AUTH=false
PORT=3000
PGPOOL_MAX=10

# PostgreSQL
DATABASE_URL=

# Telegram Mini App authentication — server only
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=3600

# Optional future Telegram login on the normal Web app
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
TELEGRAM_LOGIN_REDIRECT_URI=

# Explicit browser origins allowed to send credentialed requests.
# Production must include the deployed Web and Telegram Pages origins.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# Reserved existing server secret concepts; never expose through VITE_* variables.
SESSION_SECRET=
JWT_SECRET=
