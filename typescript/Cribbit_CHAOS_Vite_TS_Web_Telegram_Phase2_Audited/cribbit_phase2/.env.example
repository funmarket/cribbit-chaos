# Public client configuration only. Anything prefixed VITE_ is shipped to browsers.
VITE_API_URL=https://api.example.com
VITE_WS_URL=wss://api.example.com
VITE_APP_ENV=development

# Railway server-only secrets. NEVER prefix these with VITE_.
DATABASE_URL=postgresql://user:password@postgres.railway.internal:5432/railway
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_INITDATA_MAX_AGE_SECONDS=3600
SESSION_SECRET=replace_with_32_plus_random_bytes
FRONTEND_ORIGINS=https://chaos.example.com,https://chaos-telegram.example.com
PORT=3000
