{
  "name": "cribbit-chaos-platform",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:telegram": "vite --config apps/telegram/vite.config.ts",
    "dev:server": "tsx apps/server/src/index.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:telegram": "vite build --config apps/telegram/vite.config.ts",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "audit:ui": "node scripts/audit-ui.mjs",
    "check": "npm run typecheck && npm run audit:ui",
    "start:server": "tsx apps/server/src/index.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.5.0",
    "pg": "^8.16.0",
    "socket.io": "^4.8.1",
    "zod": "^4.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.2"
}
